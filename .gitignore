# =========================================================================
*.class
*.log
*.ctxt
.mtj.tmp/
hs_err_pid*
replay_pid*

# Package files (Only ignore if generated outside the maven target folder)
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

